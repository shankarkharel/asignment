# Copy with `npm run env:init` (generates random secrets) or `cp .env.example .env`
# and fill in the REPLACE_ME values. Never commit the resulting .env file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Pretty logs for `npm run start:dev`; keep false in Docker (pino-pretty is a dev dependency)
LOG_PRETTY=false

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=merchant
DATABASE_PASSWORD=REPLACE_ME
DATABASE_NAME=merchant_onboarding

REDIS_HOST=localhost
REDIS_PORT=6379

# >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN_SECONDS=900
BCRYPT_ROUNDS=12

# 32 random bytes, base64. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=REPLACE_ME

RISK_JOB_ATTEMPTS=5
RISK_JOB_BACKOFF_MS=2000
RISK_PROVIDER_TRANSIENT_FAILURE_RATE=0.2
RISK_PROVIDER_LATENCY_MS=300
RISK_RECONCILE_INTERVAL_MS=60000
RISK_RECONCILE_STALE_AFTER_MS=120000

# Password assigned to the local demo users created by `npm run seed` (dev only)
SEED_USER_PASSWORD=REPLACE_ME
